# Database Configuration
DATABASE_URL=sqlite:///./yatra.db

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
# Set ENABLE_GOOGLE_AUTH=true in production to require real Google tokens.
# When false (default) the /api/auth/dev-login endpoint is available for testing.
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Email Configuration
# When EMAIL_LOG_ONLY=true (default), emails are written to the log only.
# Set to false and provide SMTP_* vars to enable real mail delivery.
EMAIL_LOG_ONLY=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Request limits (maximum active requests per user)
SEEKER_REQUEST_LIMIT=5
VOLUNTEER_REQUEST_LIMIT=5

# Matching: departure-time buffer in hours (requests within this window are matched)
MATCH_TIME_BUFFER_HOURS=4
